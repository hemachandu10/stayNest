<% layout('/layouts/boilerplate') -%>
<body>
    <h5 class="card-title"><%=listing.title%></h5>
    <div class="card mb-3">
        <img src="<%=listing.image%>" class="card-img-top" alt="listing-image" style="height: 25rem;">
        <div class="card-body">
            <br>
            <h5>Owner: <%=listing.owner.username%></h5>
            <ul>
                <li>Description:<%=listing.description%></li>
                <li>Price:&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
                <li>Location:<%=listing.location%></li>
                <li>Country:<%=listing.country%></li>
                <li>Address:<%=listing.address%></li>
                <li>Contact Number:91+<%=listing.contactNumber%></li>
            </ul>
        </div>
    </div>    
    <% if(currentUser && listing.owner._id.equals(currentUser._id)){ %> <!-- Check if the current user is the owner of the listing -->
    <form method="get" action="/listings/<%=listing._id%>/edit">
         <button type="submit" class="btn btn-dark">Edit</button>
    </form><br>

    <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
        <button type="submit" class="btn btn-dark">Delete</button>
    </form>
    <% } %>
    <br>
    <hr>
    <% if (currentUser){ %>
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Leave a Reviews</h5>
            <form method="post" action="/listings/<%=listing._id%>/reviews" class="needs-validation" novalidate>
                <div>
                    <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="rating" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="rating" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="rating" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="rating" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="rating" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment:</label>
                    <textarea name="comment" rows="4" cols="50" class="form-control" required></textarea>
                     <div class="valid-feedback">
                            Looks good!
                    </div>
                    <div id="validationServer03Feedback" class="invalid-feedback">
                            Please provide a valid review.
                    </div>
                </div>
                <button type="submit" class="btn btn-dark mt-2">Submit Review</button>
            </form>
        </div>
    </div>
    <hr>
    <% } %>
    <h5 class="card-title">All Reviews</h5>
    <br>
    <div class="row">
        <% for(let review of listing.reviews){ %>
            <div class="card col-5 ms-3 md-3 review-card">
                <div class="card-body ">
                    <h6 class="card-title">@<%=review.author.username%></h6>
                    <p class="starability-result" data-rating="<%=review.rating%>">Rated: 3 stars</p>
                    <p class="card-text"><%=review.comment%></p>
                    <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button type="submit" class="btn btn-dark">Delete Review</button>
                    </form> 
                </div>
            </div>
        <% } %>     
    </div>


   
    
</body>

