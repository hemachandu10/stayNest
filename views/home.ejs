<% layout('/layouts/boilerplate') -%>
<body>
     <h2>All listings</h2>
     <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
         <% for(listing of alllistings){ %>
            <a href="/listings/<%=listing._id%>" class="a-img-links">
            <div class="card col" >
                <img src="<%=listing.image%>" class="card-img-top" alt="listing-image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <!-- whatever we write will print on image here we are using for opacity.whenever we hover the card it card display changes (opacity).this feature from bootstramp one of the card template -->
                <div class="card-body">
                    <p class="card-text">
                       <b><%=listing.title%></b> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>/night
                    </p>
                </div>
            </div>
            </a>
        <% } %>
     </div>
       
</body>

 