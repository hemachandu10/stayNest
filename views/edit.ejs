<% layout('/layouts/boilerplate') -%>
<body>
    <h2>make your changes</h2>
     <form method="post" action="/listings/<%=listing._id%>?_method=PUT" >
        Title<input type="text" name="listing[title]" value="<%=listing.title%>"><br><br>
        Description<input type="text" name="listing[description]" value="<%=listing.description%>"><br><br>
        Image<input type="text" name="listing[image]" value="<%=listing.image%>"><br><br>
        Price<input type="text" name="listing[price]" value="<%=listing.price%>"><br><br>
        Location<input type="text" name="listing[location]" value="<%=listing.location%>"><br><br>
        Country<input type="text" name="listing[country]" value="<%=listing.country%>"><br><br>
        <input type="submit">
    </form>
</body>
