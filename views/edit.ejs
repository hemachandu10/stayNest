<% layout('/layouts/boilerplate') -%>
<body>
    <h2>make your changes</h2>
     <form method="post" action="/listings/<%=listing._id%>?_method=PUT" >
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" value="<%=listing.title%>" class="form-control">
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]"  class="form-control"><%=listing.description%></textarea>
            <!-- <input type="text" name="listing[description]" placeholder="enter description"> -->
        </div>
        <div class="mb-3">
            <label for="Image" class="form-label">Image</label>
            <input type="text" name="listing[image]" value="<%=listing.image%>" class="form-control">
        </div>
        <div class="mb-3">
            <label for="Price" class="form-label">Price</label>
            <input type="text" name="listing[price]" value="<%=listing.price%>" class="form-control">
        </div>
        <div class="mb-3">
            <label for="Location" class="form-label">Location</label>
            <input type="text" name="listing[location]" value="<%=listing.location%>" class="form-control">
        </div>
        <div class="mb-3">
            <label for="Country" class="form-label">Country</label>
            <input type="text" name="listing[country]" value="<%=listing.country%>" class="form-control">
        </div>
        <button type="submit" class="btn btn-dark">Submit</button>
        
      
</body>
